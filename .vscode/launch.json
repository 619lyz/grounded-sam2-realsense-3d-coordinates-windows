        {
            "name": "Run main demo (RealSense)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "--source",
                "realsense"
            ],
            "justMyCode": false
        }
    ]
}
